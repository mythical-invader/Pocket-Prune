# PocketPrune settings — copy this file to `.env` (in the repo root) and fill in your values.
# `.env` is git-ignored: never commit real passwords or tokens.
# Settings marked (later) are read by work packages that are not built yet; keep them here so
# both teammates use the same names from day one.

# ---------- API server ----------
PORT=8000
NODE_ENV=development

# ---------- Database ----------
# Shared dev database: the MongoDB Atlas M0 connection string (both laptops use the same one).
# Working alone? A local MongoDB works too: mongodb://127.0.0.1:27017/pocketprune
MONGO_URI=mongodb://127.0.0.1:27017/pocketprune

# ---------- Login (later: WP-21) ----------
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Until login exists (WP-21) every request acts as this demo user (created automatically).
DEMO_USER_EMAIL=demo@pocketprune.local

# ---------- llama.cpp (model machine only: WP-02 / WP-04) ----------
# Folder where build-llamacpp.sh cloned and built llama.cpp (WSL2 / Ubuntu path).
LLAMA_CPP_DIR=/home/<you>/llama.cpp
# The pinned llama.cpp release tag; preflight refuses to run with a different build.
LLAMA_CPP_REF=b0000
# Hugging Face token — only needed for gated models such as meta-llama/Llama-3.2-1B-Instruct.
HF_TOKEN=

# ---------- Files on disk ----------
# Where downloads, GGUF files and the WikiText-2 text are kept (relative to the repo root).
DATA_DIR=data

# ---------- Pipeline behaviour ----------
# true = shorter benchmarks and 10 perplexity chunks (for live demos).
DEMO_MODE=false
# ⏳ TEMPORARY (WP-06 → removed in WP-20): true = the worker runs fakePipeline.js with
# realistic numbers instead of llama.cpp, so the website can be built on Windows.
FAKE_PIPELINE=false

# ---------- Limits ----------
MAX_ACTIVE_JOBS_PER_USER=2
USER_STORAGE_LIMIT_MB=3072
ARTIFACT_EXPIRY_DAYS=7
MAX_PARAMS_BILLION=4
# Minimum free disk the pipeline always keeps, in MB.
DISK_RESERVE_MB=2048

# ---------- Stage time limits (minutes) ----------
TIMEOUT_DOWNLOAD_MIN=60
TIMEOUT_CONVERT_MIN=30
TIMEOUT_QUANTIZE_MIN=20
TIMEOUT_SMOKE_MIN=2
TIMEOUT_BENCH_MIN=15
TIMEOUT_PERPLEXITY_MIN=30
